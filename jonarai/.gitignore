# ---------- Trading-specific: NEVER commit these ----------
# Broker credentials, API keys, private material.
# JONARAI does not need any of these in the repo; treat any file matching
# these patterns as sensitive by default.
secrets/
credentials.json
credentials.*.json
broker-tokens/
*.pem
*.key
*.p12
*.pfx
ibkr-*.json
tws-*.json

# ---------- Data snapshots (large / licensed) ----------
# Raw market data may be licensed and non-redistributable — keep it out.
data/raw/
data/snapshots/
*.parquet
*.feather
