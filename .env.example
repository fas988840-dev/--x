# Environment Configuration Template
# NEVER commit the actual .env file with real credentials
# Copy to .env.local for local development

# Server Configuration
PORT=3000
NODE_ENV=development

# Solana RPC Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# CORS Configuration
# Comma-separated list of exact allowed origins (browser access only -
# does not restrict curl/server-to-server access, see API_KEYS below)
CORS_ORIGIN=http://localhost:3000

# API Key Authentication (optional)
# Comma-separated list of valid keys. Leave unset to keep the API open
# (dev-friendly default). Set this in production to require every
# request (except /api/v1/health) to send a matching X-API-Key header.
# API_KEYS=change-me-to-a-real-secret,another-key-for-a-second-client

# Price Provider Configuration
# Default (unset) uses CoinGeckoPriceProvider - CoinGecko's free public API,
# no key required. Set to "stub" to force StubPriceProvider (always null
# prices) instead, e.g. for offline development.
# PRICE_PROVIDER=stub

# ChainGPT API Key (optional)
# Used only by ExplanationAgent (GET /api/v1/wallet/:address/explanation, the
# 'wallet_explanation' agent-router intent, and the wallet_explanation MCP
# tool) to rephrase already-computed wallet/risk facts in plain language -
# see src/services/chaingpt-client.ts for the honest verification-status
# note on its exact REST shape. Leave unset to keep that endpoint working
# with a deterministic (non-AI) summary instead of failing.
# Generate a key at https://app.chaingpt.org/apidashboard -> "Create Secret Key"
# CHAINGPT_API_KEY=your-chaingpt-api-key

# Note: This is a TEMPLATE ONLY
# Actual credentials should NEVER be stored in version control
# Use .env.local or system environment variables for local development
